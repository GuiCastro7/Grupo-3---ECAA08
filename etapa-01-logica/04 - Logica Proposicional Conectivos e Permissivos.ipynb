from typing import Dict, Any
import pandas as pd

# ==============================================================================
# 1. OPERADORES FUNDAMENTAIS DA LÓGICA PROPOSICIONAL
# ==============================================================================

def NOT(p: bool) -> bool:
    return not p

def AND(*args: bool) -> bool:
    return all(args)

def OR(*args: bool) -> bool:
    return any(args)

def XOR(p: bool, q: bool) -> bool:
    return p ^ q


# ==============================================================================
# 2. BLOCOS DE INTERTRAVAMENTO INDIVIDUAIS
# ==============================================================================

def intertrava_BC1(sp_1_ok: bool, sq_1_ok: bool, ls_VS1_open: bool,
                   p_AS1_high: bool, e_stop: bool, modo_valido: bool) -> Dict[str, bool]:
    """
    Bomba Centrífuga de Alimentação (BC1):
    Permissivo: sp_1_ok ∧ sq_1_ok ∧ ls_VS1_open ∧ ¬p_AS1_high ∧ ¬e_stop ∧ (Auto ⊕ Manual)
    Trip: ¬sp_1_ok ∨ ¬sq_1_ok ∨ ¬ls_VS1_open ∨ p_AS1_high ∨ e_stop
    """
    trip = OR(NOT(sp_1_ok), NOT(sq_1_ok), NOT(ls_VS1_open), p_AS1_high, e_stop)
    permissivo = AND(sp_1_ok, sq_1_ok, ls_VS1_open, NOT(p_AS1_high), NOT(e_stop), modo_valido)
    return {"permissivo": permissivo, "trip": trip}


def intertrava_RC1(act_VS2: bool, ext_VS3: bool, ext_VS4: bool,
                   ext_VS5: bool, e_stop: bool, modo_valido: bool) -> Dict[str, bool]:
    """
    Esteira Transportadora (RC1):
    Permissivo: ¬act_VS2 ∧ ¬ext_VS3 ∧ ¬ext_VS4 ∧ ¬ext_VS5 ∧ ¬e_stop ∧ (Auto ⊕ Manual)
    Trip: e_stop ∨ act_VS2 ∨ ext_VS3 ∨ ext_VS4 ∨ ext_VS5
    """
    trip = OR(e_stop, act_VS2, ext_VS3, ext_VS4, ext_VS5)
    permissivo = AND(NOT(act_VS2), NOT(ext_VS3), NOT(ext_VS4), NOT(ext_VS5), NOT(e_stop), modo_valido)
    return {"permissivo": permissivo, "trip": trip}


def intertrava_VS2(s_pos_VS2: bool, cmd_RC1: bool, sp_2_ok: bool,
                   e_stop: bool, modo_valido: bool) -> Dict[str, bool]:
    """
    Válvula de Enchimento/Envase (VS2):
    Permissivo: s_pos_VS2 ∧ ¬cmd_RC1 ∧ sp_2_ok ∧ ¬e_stop ∧ (Auto ⊕ Manual)
    Trip: ¬s_pos_VS2 ∨ cmd_RC1 ∨ ¬sp_2_ok ∨ e_stop
    """
    trip = OR(NOT(s_pos_VS2), cmd_RC1, NOT(sp_2_ok), e_stop)
    permissivo = AND(s_pos_VS2, NOT(cmd_RC1), sp_2_ok, NOT(e_stop), modo_valido)
    return {"permissivo": permissivo, "trip": trip}


def intertrava_VS3(s_pos_VS3: bool, cmd_RC1: bool, e_stop: bool, modo_valido: bool) -> Dict[str, bool]:
    """
    Módulo de Inspeção de Nível (VS3 / SL1):
    Permissivo: s_pos_VS3 ∧ ¬cmd_RC1 ∧ ¬e_stop ∧ (Auto ⊕ Manual)
    Trip: ¬s_pos_VS3 ∨ cmd_RC1 ∨ e_stop
    """
    trip = OR(NOT(s_pos_VS3), cmd_RC1, e_stop)
    permissivo = AND(s_pos_VS3, NOT(cmd_RC1), NOT(e_stop), modo_valido)
    return {"permissivo": permissivo, "trip": trip}


def intertrava_VS4(s_pos_VS4: bool, aprov_nivel: bool, cmd_RC1: bool,
                   e_stop: bool, modo_valido: bool) -> Dict[str, bool]:
    """
    Módulo de Tampagem (VS4 / AC1):
    Permissivo: s_pos_VS4 ∧ aprov_nivel ∧ ¬cmd_RC1 ∧ ¬e_stop ∧ (Auto ⊕ Manual)
    Trip: ¬s_pos_VS4 ∨ ¬aprov_nivel ∨ cmd_RC1 ∨ e_stop
    """
    trip = OR(NOT(s_pos_VS4), NOT(aprov_nivel), cmd_RC1, e_stop)
    permissivo = AND(s_pos_VS4, aprov_nivel, NOT(cmd_RC1), NOT(e_stop), modo_valido)
    return {"permissivo": permissivo, "trip": trip}


def intertrava_VS5(s_pos_VS5: bool, cmd_RC1: bool, e_stop: bool, modo_valido: bool) -> Dict[str, bool]:
    """
    Módulo de Inspeção de Vedação (VS5 / SFC1):
    Permissivo: s_pos_VS5 ∧ ¬cmd_RC1 ∧ ¬e_stop ∧ (Auto ⊕ Manual)
    Trip: ¬s_pos_VS5 ∨ cmd_RC1 ∨ e_stop
    """
    trip = OR(NOT(s_pos_VS5), cmd_RC1, e_stop)
    permissivo = AND(s_pos_VS5, NOT(cmd_RC1), NOT(e_stop), modo_valido)
    return {"permissivo": permissivo, "trip": trip}


# ==============================================================================
# 3. AVALIADOR GLOBAL DO VETOR DE ESTADOS DA PLANTA
# ==============================================================================

def avaliar_vetor_estados(planta: Dict[str, bool]) -> Dict[str, Any]:
    """
    Recebe o vetor de estados (dicionário de sensores e comandos) e
    processa o status operacional de toda a linha.
    """
    modo_valido = XOR(planta.get("auto_mode", False), planta.get("manual_mode", False))
    e_stop = planta.get("e_stop", False)
    cmd_RC1 = planta.get("cmd_RC1", False)

    # 1. Bomba BC1
    bc1 = intertrava_BC1(
        sp_1_ok=planta.get("sp_1_ok", False),
        sq_1_ok=planta.get("sq_1_ok", False),
        ls_VS1_open=planta.get("ls_VS1_open", False),
        p_AS1_high=planta.get("p_AS1_high", False),
        e_stop=e_stop,
        modo_valido=modo_valido
    )

    # 2. Esteira RC1
    rc1 = intertrava_RC1(
        act_VS2=planta.get("act_VS2", False),
        ext_VS3=planta.get("ext_VS3", False),
        ext_VS4=planta.get("ext_VS4", False),
        ext_VS5=planta.get("ext_VS5", False),
        e_stop=e_stop,
        modo_valido=modo_valido
    )

    # 3. Válvula de Enchimento VS2
    vs2 = intertrava_VS2(
        s_pos_VS2=planta.get("s_pos_VS2", False),
        cmd_RC1=cmd_RC1,
        sp_2_ok=planta.get("sp_2_ok", False),
        e_stop=e_stop,
        modo_valido=modo_valido
    )

    # 4. Inspeção de Nível VS3 (SL1)
    vs3 = intertrava_VS3(
        s_pos_VS3=planta.get("s_pos_VS3", False),
        cmd_RC1=cmd_RC1,
        e_stop=e_stop,
        modo_valido=modo_valido
    )
    # Validação do sensor de nível
    aprov_nivel = AND(planta.get("ext_VS3", False), planta.get("sl1_ok", False))

    # 5. Tampagem VS4 (AC1)
    vs4 = intertrava_VS4(
        s_pos_VS4=planta.get("s_pos_VS4", False),
        aprov_nivel=planta.get("aprov_nivel", aprov_nivel),
        cmd_RC1=cmd_RC1,
        e_stop=e_stop,
        modo_valido=modo_valido
    )

    # 6. Inspeção de Vedação VS5 (SFC1)
    vs5 = intertrava_VS5(
        s_pos_VS5=planta.get("s_pos_VS5", False),
        cmd_RC1=cmd_RC1,
        e_stop=e_stop,
        modo_valido=modo_valido
    )
    # Validação do sensor de fim de curso SFC1
    aprov_vedacao = AND(planta.get("ext_VS5", False), planta.get("sfc_1", False))

    return {
        "Modo_Valido": modo_valido,
        "Permissivo_BC1": bc1["permissivo"], "Trip_BC1": bc1["trip"],
        "Permissivo_RC1": rc1["permissivo"], "Trip_RC1": rc1["trip"],
        "Permissivo_VS2": vs2["permissivo"], "Trip_VS2": vs2["trip"],
        "Permissivo_VS3": vs3["permissivo"], "Trip_VS3": vs3["trip"],
        "Aprov_Nivel": aprov_nivel,
        "Permissivo_VS4": vs4["permissivo"], "Trip_VS4": vs4["trip"],
        "Permissivo_VS5": vs5["permissivo"], "Trip_VS5": vs5["trip"],
        "Aprov_Vedacao": aprov_vedacao
    }


# ==============================================================================
# 4. SIMULAÇÃO DE CENÁRIOS OPERACIONAIS (TESTES)
# ==============================================================================

if __name__ == "__main__":
    cenarios = [
        {
            "descricao": "Cenário 1: Operação Normal - Partida da Bomba BC1",
            "vetor": {
                "auto_mode": True, "manual_mode": False, "e_stop": False,
                "sp_1_ok": True, "sq_1_ok": True, "ls_VS1_open": True, "p_AS1_high": False,
                "cmd_RC1": False, "act_VS2": False, "ext_VS3": False, "ext_VS4": False, "ext_VS5": False
            }
        },
        {
            "descricao": "Cenário 2: Emergência Acionada (E-STOP)",
            "vetor": {
                "auto_mode": True, "manual_mode": False, "e_stop": True,
                "sp_1_ok": True, "sq_1_ok": True, "ls_VS1_open": True, "p_AS1_high": False,
                "cmd_RC1": False, "act_VS2": False, "ext_VS3": False, "ext_VS4": False, "ext_VS5": False
            }
        },
        {
            "descricao": "Cenário 3: Esteira em movimento (Bloqueia estações de trabalho)",
            "vetor": {
                "auto_mode": True, "manual_mode": False, "e_stop": False,
                "cmd_RC1": True, "s_pos_VS2": True, "sp_2_ok": True,
                "s_pos_VS3": True, "s_pos_VS4": True, "aprov_nivel": True, "s_pos_VS5": True
            }
        },
        {
            "descricao": "Cenário 4: Atuador VS3 estendido (Bloqueia movimento da esteira RC1)",
            "vetor": {
                "auto_mode": True, "manual_mode": False, "e_stop": False,
                "cmd_RC1": False, "act_VS2": False, "ext_VS3": True, "ext_VS4": False, "ext_VS5": False
            }
        }
    ]

    tabela_resultados = []
    for c in cenarios:
        res = avaliar_vetor_estados(c["vetor"])
        res_resumo = {
            "Cenário": c["descricao"],
            "Perm_BC1": res["Permissivo_BC1"],
            "Trip_BC1": res["Trip_BC1"],
            "Perm_RC1": res["Permissivo_RC1"],
            "Trip_RC1": res["Trip_RC1"],
            "Perm_VS2": res["Permissivo_VS2"],
            "Trip_VS2": res["Trip_VS2"],
            "Perm_VS4": res["Permissivo_VS4"],
            "Trip_VS4": res["Trip_VS4"]
        }
        tabela_resultados.append(res_resumo)

    df_resultado = pd.DataFrame(tabela_resultados)
    print(df_resultado.to_string(index=False))
